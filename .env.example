# Ollama — local inference, no API cost
# Install: https://ollama.com  |  Pull model: ollama pull qwen2.5vl:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Google Sheets — service account (no login required)
# Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=your-sheet-id
# From your service account JSON file (client_email field)
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# From your service account JSON file (private_key field, keep \n as literal \n)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# Optional: tab name in the sheet, defaults to "Applications"
GOOGLE_SHEET_NAME=Applications
