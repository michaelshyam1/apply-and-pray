{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apply and Pray",
  "version": "0.1.0",
  "identifier": "com.applyandpray.app",
  "build": {
    "beforeDevCommand": "node scripts/load-env-and-dev.mjs",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build && node scripts/copy-standalone.mjs",
    "frontendDist": "../public"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  }
}
